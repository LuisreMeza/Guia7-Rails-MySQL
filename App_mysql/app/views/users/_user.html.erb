<div id="<%= dom_id user %>">
  <div>
    <strong>Name:</strong>
    <%= user.name %>
  </div>

  <div>
    <strong>Password:</strong>
    <%= user.password %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= user.email %>
  </div>

  <div>
    <strong>Programador:</strong>
    <%= user.programador %>
  </div>

  <div>
    <strong>Birthday:</strong>
    <%= user.birthday %>
  </div>

  <div>
    <strong>Work time:</strong>
    <%= user.work_time %>
  </div>

</div>
